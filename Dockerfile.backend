FROM golang:1.19

WORKDIR /app

#  Copia i requisiti Installa le dipendenze
COPY go.mod go.sum ./
RUN go mod download

# Copia il codice sorgente del backend
COPY cmd/ ./cmd/ 
COPY service/ ./service/

# Compila
RUN go build -o /bin/webapi ./cmd/webapi

# Connessione alla porta 3000
EXPOSE 3000

CMD ["/bin/webapi"]

