# --- FASE 1: Compilazione (con Yarn, come il tuo) ---
FROM node:20-alpine AS builder

WORKDIR /app

COPY webui/package.json webui/yarn.lock webui/.yarnrc.yml ./
COPY webui/.yarn ./.yarn
RUN yarn install

COPY webui/ ./
RUN yarn run build-prod

# --- FASE 2: Server Nginx avanzato (Vue Router + Reverse Proxy) ---
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html

# Scriviamo la configurazione personalizzata per Nginx
RUN echo 'server { \
    listen 80; \
    resolver 127.0.0.11 valid=30s; \
    location / { \
        root /usr/share/nginx/html; \
        index index.html index.htm; \
        try_files $uri $uri/ /index.html; \
    } \
    location ~ ^/(session|users|conversations|chats|groups|messages|comments) { \
        set $backend http://backend:3000; \
        proxy_pass $backend; \
        proxy_http_version 1.1; \
        proxy_set_header Upgrade $http_upgrade; \
        proxy_set_header Connection "upgrade"; \
    } \
    location /images/ { \
        set $backend http://backend:3000; \
        proxy_pass $backend; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
